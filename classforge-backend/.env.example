PROJECT_NAME="ClassForge"
ENVIRONMENT="development"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-me-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="classforge"
INACTIVITY_TIMEOUT_MINUTES=30
# Comma-separated allowed origins — Rule R03: never use * in production
CORS_ORIGINS="http://localhost:4200,http://localhost:4201"
# ── Local LLM & Routing Configuration (P8a) ──────────────────────────────
# Ollama endpoint (strictly loaded from environment, never from client)
OLLAMA_URL="http://localhost:11434"
# Recommended 1-3B Q4 class model on CPU (e.g. qwen2.5:1.5b, llama3.2:1b, tinyllama)
OLLAMA_MODEL="qwen2.5:1.5b"
OLLAMA_TIMEOUT_S=12.0
# Secret header X-Local-LLM-Secret for reverse proxy authentication of Cloudflare Tunnel
LOCAL_LLM_SECRET=""
# Latency threshold before circuit breaker or next fallback link
LOCAL_LATENCY_THRESHOLD_S=15.0
# Purpose-based routing chain (Ollama -> Gemini -> Heuristic)
LLM_ROUTING='{"uml_command":["ollama","gemini","heuristic"],"role_chat":["gemini"],"role_review":["gemini"],"vision":["gemini"],"codegen":["gemini"],"digest":["gemini","ollama"]}'
# Strict privacy mode: never use Gemini (disables cloud roles with explanation)
AI_LOCAL_ONLY=false

# ── LLM Configuration (P2 unified client) ──────────────────────────────────
# Provider: "gemini" in production/staging; "fake" in automated tests and E2E
LLM_PROVIDER="gemini"
# Gemini server API key (handled as SecretStr; client may also pass X-Gemini-Key header)
GEMINI_API_KEY=""
# Ordered fallback model chain (verified current models only, no deprecated names)
GEMINI_MODELS="gemini-3.8-flash,gemini-2.5-flash,gemini-2.0-flash"
# Request timeouts and retries (backoff with jitter on 429/5xx/timeout; 400/401/403 never retried)
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_ATTEMPTS=3
# Circuit breaker (opens for 30s after 5 consecutive failures)
LLM_CIRCUIT_BREAKER_FAILURES=5
LLM_CIRCUIT_BREAKER_RECOVERY_SECONDS=30.0
# Token budgets per purpose (hard ceiling 65,536; reasoning/thinking consumes part of budget)
LLM_MAX_OUTPUT_TOKENS_CHAT=2048
LLM_MAX_OUTPUT_TOKENS_TASK=8192
LLM_MAX_OUTPUT_TOKENS_CODEGEN=32768
LLM_MAX_OUTPUT_TOKENS_VISION=4096

# Switch for AI chat service (when false, returns 503 Service Unavailable)
AI_CHAT_ENABLED=true
AI_CONTEXT_BUDGET_TOKENS=8000
AI_CONTEXT_MAX_TOKENS=8000
