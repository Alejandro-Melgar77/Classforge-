# ==============================================================================
# ClassForge 2.0 — Production & Docker Compose Configuration
# ==============================================================================

# Clave secreta criptográfica (OBLIGATORIA: cambiar por valor aleatorio seguro de 32+ caracteres)
SECRET_KEY=change-this-to-a-very-long-random-secret-key-32-chars-min

# MongoDB Credentials
MONGO_USER=classforge
MONGO_PASSWORD=change_this_password_in_production

# Optional External AI API Key (Gemini)
GEMINI_API_KEY=

# Local LLM Service (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Port bindings
BACKEND_PORT=8000
FRONTEND_PORT=80
MONGO_PORT=27017
